// Playtime: period chips, four total tiles, a stacked bar chart (playing / watching per day, month or
// year) and the most played / most watched lists — the renderer's VIEWS.stats, statsChart, statsList.
// Rust (app/src/ui/pages/stats.rs) aggregates the session log (renderer/stats.js) into StatsData.
//
// Focus zones, top to bottom: 0 = period chips, 1 = chart bars, 2 = the two lists (side by side, or
// stacked on narrow windows like the CSS's max-width: 1100px).

import { Theme, Motion } from "../theme.slint";
import { T, Art, Input, Nav, Hints } from "../globals.slint";
import { PageScope, Icon, Pointer } from "../widgets.slint";
import { ChipBar, GridChip } from "grid.slint";

export struct StatTile {
    label: string,
    value: string,
    sub: string,
}

export struct StatBucket {
    game: float,       // fraction of the chart's top gridline
    watch: float,
    has-game: bool,
    has-watch: bool,
    label: string,     // under the bar ("" when thinned out)
    summary: string,   // the readout ("Monday, October 4 · 1h 2m playing · 0m watching")
}

export struct StatGridLine {
    frac: float,       // 0 = baseline, 1 = top
    label: string,
}

export struct StatRow {
    title: string,
    art: string,       // poster path
    icon: string,      // a game's icon when there's no poster
    tint: color,       // placeholder gradient
    tint2: color,
    frac: float,       // bar width relative to the first row
    time: string,
}

export struct StatsData {
    loaded: bool,
    periods: [GridChip],
    tiles: [StatTile],
    has-log: bool,
    buckets: [StatBucket],
    grid: [StatGridLine],
    games: [StatRow],
    watched: [StatRow],
}

export struct StatsFocus {
    zone: int,         // 0 = periods, 1 = bars, 2 = lists
    period: int,
    bar: int,
    list: int,         // 0 = most played, 1 = most watched
    row: int,
}

export global StatsPage {
    in property <StatsData> data;
    in-out property <StatsFocus> pos;
    // The bar the readout describes (-1: the "select a bar" hint).
    in-out property <int> readout: -1;
    callback period(int);              // chip index
    callback open(int, int);           // list, row
    callback options(int, int);        // list, row
}

// The renderer's --series-game / --series-watch.
global StatColors {
    out property <color> game: #d95926;
    out property <color> watch: #3987e5;
}

component TileView inherits Rectangle {
    in property <StatTile> tile;
    border-radius: Theme.radius;
    background: Theme.surface;
    VerticalLayout {
        padding-left: 1.3 * Theme.rem;
        padding-right: 1.3 * Theme.rem;
        padding-top: 1.1 * Theme.rem;
        padding-bottom: 1.1 * Theme.rem;
        alignment: start;
        Text {
            text: tile.label;
            color: Theme.muted;
            font-size: 1 * Theme.rem;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: tile.value;
            color: Theme.text;
            font-size: 2.3 * Theme.rem;
            font-weight: 700;
            letter-spacing: -0.02 * 2.3 * Theme.rem;
            overflow: elide;
        }
        if tile.sub != "": Text {
            text: tile.sub;
            color: Theme.faint;
            font-size: 0.95 * Theme.rem;
            overflow: elide;
        }
    }
}

// `.stat-row`: rank, poster, title over a bar, time.
component StatRowView inherits Rectangle {
    in property <StatRow> item;
    in property <int> rank;
    in property <bool> focused;
    in property <color> series;
    callback clicked();
    callback hovered();
    callback options();
    private property <color> ink: focused ? Theme.accent-ink : Theme.text;
    height: 4.7 * Theme.rem;
    border-radius: 0.6 * Theme.rem;
    background: focused ? Theme.focus : Theme.surface;
    transform-scale: focused ? 1.015 : 1.0;
    animate background, transform-scale { duration: Motion.fast; easing: Motion.ease; }
    HorizontalLayout {
        padding-left: 0.9 * Theme.rem;
        padding-right: 0.9 * Theme.rem;
        padding-top: 0.55 * Theme.rem;
        padding-bottom: 0.55 * Theme.rem;
        spacing: 1 * Theme.rem;
        Text {
            width: 1.4 * Theme.rem;
            text: rank;
            color: focused ? #3a3f4a : Theme.faint;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            width: 2.6 * Theme.rem;
            height: 3.6 * Theme.rem;
            border-radius: 0.3 * Theme.rem;
            clip: true;
            background: Theme.surface-2;
            if item.art != "": Image {
                width: parent.width;
                height: parent.height;
                source: Art.get(item.art, self.width);
                image-fit: cover;
            }
            if item.art == "" && item.icon != "": Image {
                x: 0.3 * Theme.rem;
                y: 0.3 * Theme.rem;
                width: parent.width - 0.6 * Theme.rem;
                height: parent.height - 0.6 * Theme.rem;
                source: Art.get(item.icon, self.width);
                image-fit: contain;
            }
            if item.art == "" && item.icon == "": Rectangle {
                background: @linear-gradient(135deg, item.tint 0%, item.tint2 100%);
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 0.45 * Theme.rem;
            Text {
                text: item.title;
                color: ink;
                font-size: 1.15 * Theme.rem;
                font-weight: 600;
                overflow: elide;
            }
            Rectangle {
                height: 0.35 * Theme.rem;
                border-radius: self.height / 2;
                background: focused ? #0000001f : #ffffff1a;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, item.frac));
                    border-radius: parent.height / 2;
                    background: series;
                }
            }
        }
        Text {
            text: item.time;
            color: ink;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    Pointer {
        hovered => { root.hovered(); }
        options => { root.options(); }
        clicked => {
            if (!self.consume-long-press()) {
                root.clicked();
            }
        }
    }
}

// `.stat-list`: a heading and up to eight rows (or "Nothing in this period.").
component StatListView inherits VerticalLayout {
    in property <string> title;
    in property <[StatRow]> rows;
    in property <color> series;
    in property <int> focused-row: -1;
    callback clicked(int);
    callback hovered(int);
    callback options(int);
    // y (relative to this list) and height of the focused row, for the page to scroll to.
    callback reveal(length, length);
    spacing: 0;
    alignment: start;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 1.4 * Theme.rem;
        font-weight: 700;
    }
    Rectangle { height: 0.8 * Theme.rem; }
    for r[i] in rows: VerticalLayout {
        padding-bottom: 0.35 * Theme.rem;
        StatRowView {
            item: r;
            rank: i + 1;
            series: root.series;
            focused: i == root.focused-row;
            clicked => { root.clicked(i); }
            hovered => { root.hovered(i); }
            options => { root.options(i); }
            changed focused => {
                if (self.focused) {
                    root.reveal(parent.y, self.height);
                }
            }
        }
    }
    if rows.length == 0: Text {
        text: T.tr("stats.nothing");
        color: Theme.muted;
        font-size: 1.3 * Theme.rem;
        wrap: word-wrap;
        height: self.preferred-height + 4 * Theme.rem;
        vertical-alignment: center;
    }
}

export component StatsView inherits Rectangle {
    private property <StatsData> data: StatsPage.data;
    private property <StatsFocus> pos: StatsPage.pos;
    private property <int> nb: data.has-log ? data.buckets.length : 0;
    private property <bool> narrow: self.width < 1100px;
    private property <int> hover-bar: -1;
    private property <[StatRow]> cur-list: pos.list == 0 ? data.games : data.watched;

    function hints() {
        if (pos.zone == 2) {
            Hints.items = [{ button: "a", label: T.tr("hint.select") }, { button: "x", label: T.tr("hint.options") }, { button: "b", label: T.tr("hint.back") }, { button: "menu", label: T.tr("hint.menu") }];
        } else {
            Hints.items = [{ button: "a", label: T.tr("hint.select") }, { button: "b", label: T.tr("hint.back") }, { button: "menu", label: T.tr("hint.menu") }];
        }
    }
    function store(f: StatsFocus) {
        StatsPage.pos = f;
        if (f.zone == 1) { StatsPage.readout = f.bar; }
        if (f.zone == 0) { flick.content-y = 0; }
        hints();
    }
    function set-period(i: int) { store({ zone: 0, period: i, bar: pos.bar, list: pos.list, row: pos.row }); }
    function set-bar(i: int) { store({ zone: 1, period: pos.period, bar: i, list: pos.list, row: pos.row }); }
    function set-row(l: int, r: int) { store({ zone: 2, period: pos.period, bar: pos.bar, list: l, row: r }); }
    function list-len(l: int) -> int { l == 0 ? data.games.length : data.watched.length }
    // Down from the chips or the chart: the first list that has rows.
    function into-lists() -> bool {
        if (data.games.length > 0) { set-row(0, 0); return true; }
        if (data.watched.length > 0) { set-row(1, 0); return true; }
        false
    }
    // Scroll so a band of the content (y, h) is visible below the top bar.
    function reveal(y: length, h: length) {
        if (y + flick.content-y < 8 * Theme.rem) {
            flick.content-y = min(0, -(y - 8 * Theme.rem));
        }
        if (y + h + flick.content-y > flick.height - 3 * Theme.rem) {
            flick.content-y = -(y + h - flick.height + 3 * Theme.rem);
        }
    }
    init => {
        if (pos.zone == 1 && nb == 0) { set-period(pos.period); }
        if (pos.zone == 2 && list-len(pos.list) == 0) { set-period(pos.period); }
        hints();
    }

    scope := PageScope {
        key-pressed(e) => {
            if (!data.loaded) {
                if (e.text == Key.UpArrow) { Nav.focus-top(); Input.feedback("move"); return accept; }
                return reject;
            }
            if (pos.zone == 0) {
                if (e.text == Key.LeftArrow) { if (pos.period > 0) { set-period(pos.period - 1); Input.feedback("move"); } return accept; }
                if (e.text == Key.RightArrow) { if (pos.period < data.periods.length - 1) { set-period(pos.period + 1); Input.feedback("move"); } return accept; }
                if (e.text == Key.UpArrow) { Nav.focus-top(); Input.feedback("move"); return accept; }
                if (e.text == Key.DownArrow) {
                    if (nb > 0) { set-bar(max(0, min(pos.bar, nb - 1))); Input.feedback("move"); }
                    else if (into-lists()) { Input.feedback("move"); }
                    return accept;
                }
                if (e.text == Key.Return || e.text == " ") { Input.feedback("select"); StatsPage.period(pos.period); return accept; }
                return reject;
            }
            if (pos.zone == 1) {
                if (e.text == Key.LeftArrow) { if (pos.bar > 0) { set-bar(pos.bar - 1); Input.feedback("move"); } return accept; }
                if (e.text == Key.RightArrow) { if (pos.bar < nb - 1) { set-bar(pos.bar + 1); Input.feedback("move"); } return accept; }
                if (e.text == Key.PageUp) { set-bar(0); Input.feedback("move"); return accept; }
                if (e.text == Key.PageDown) { set-bar(nb - 1); Input.feedback("move"); return accept; }
                if (e.text == Key.UpArrow) { set-period(pos.period); Input.feedback("move"); return accept; }
                if (e.text == Key.DownArrow) { if (into-lists()) { Input.feedback("move"); } return accept; }
                if (e.text == Key.Return || e.text == " ") { return accept; }
                return reject;
            }
            // Lists.
            if (e.text == Key.UpArrow) {
                if (pos.row > 0) { set-row(pos.list, pos.row - 1); }
                else if (narrow && pos.list == 1 && data.games.length > 0) { set-row(0, data.games.length - 1); }
                else if (nb > 0) { set-bar(max(0, min(pos.bar, nb - 1))); }
                else { set-period(pos.period); }
                Input.feedback("move");
                return accept;
            }
            if (e.text == Key.DownArrow) {
                if (pos.row < list-len(pos.list) - 1) { set-row(pos.list, pos.row + 1); Input.feedback("move"); }
                else if (narrow && pos.list == 0 && data.watched.length > 0) { set-row(1, 0); Input.feedback("move"); }
                return accept;
            }
            if (!narrow && e.text == Key.LeftArrow) {
                if (pos.list == 1 && data.games.length > 0) { set-row(0, min(pos.row, data.games.length - 1)); Input.feedback("move"); }
                return accept;
            }
            if (!narrow && e.text == Key.RightArrow) {
                if (pos.list == 0 && data.watched.length > 0) { set-row(1, min(pos.row, data.watched.length - 1)); Input.feedback("move"); }
                return accept;
            }
            if (e.text == Key.LeftArrow || e.text == Key.RightArrow) { return accept; }
            if (e.text == Key.PageUp) { set-row(pos.list, 0); Input.feedback("move"); return accept; }
            if (e.text == Key.PageDown) { set-row(pos.list, list-len(pos.list) - 1); Input.feedback("move"); return accept; }
            if (e.text == Key.Return || e.text == " ") { Input.feedback("select"); StatsPage.open(pos.list, pos.row); return accept; }
            if (e.text == Key.Menu) { StatsPage.options(pos.list, pos.row); return accept; }
            reject
        }
    }

    flick := Flickable {
        changed content-y => { Nav.scrolled = self.content-y < -1px; }
        content-width: self.width;
        content-height: body.preferred-height;
        animate content-y { duration: Motion.normal; easing: Motion.ease; }
        body := VerticalLayout {
            padding-top: Theme.page-top;
            padding-bottom: 3 * Theme.rem + 4 * Theme.rem;   // .stats padding + room for the hint bar
            alignment: start;
            // .page-head
            HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-top: 1 * Theme.rem;
                padding-bottom: 1.2 * Theme.rem;
                Text {
                    text: T.tr("stats.title");
                    color: Theme.text;
                    font-size: 3 * Theme.rem;
                    font-weight: 700;
                    letter-spacing: -0.02 * 3 * Theme.rem;
                }
            }
            if !data.loaded: HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-top: 2 * Theme.rem;
                Text {
                    text: T.tr("stats.loading");
                    color: Theme.muted;
                    font-size: 1.3 * Theme.rem;
                }
            }
            if data.loaded: ChipBar {
                chips: data.periods;
                focus-index: scope.has-focus && pos.zone == 0 ? pos.period : -1;
                clicked(i) => { set-period(i); StatsPage.period(i); }
                hovered(i) => { if (Input.mode == "mouse") { set-period(i); } }
            }
            // .stat-tiles: four across, two by two on narrow windows.
            if data.loaded: VerticalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-top: 0.6 * Theme.rem;
                padding-bottom: 1.6 * Theme.rem;
                spacing: 1 * Theme.rem;
                HorizontalLayout {
                    spacing: 1 * Theme.rem;
                    TileView { tile: data.tiles[0]; horizontal-stretch: 1; }
                    TileView { tile: data.tiles[1]; horizontal-stretch: 1; }
                    if !narrow: TileView { tile: data.tiles[2]; horizontal-stretch: 1; }
                    if !narrow: TileView { tile: data.tiles[3]; horizontal-stretch: 1; }
                }
                if narrow: HorizontalLayout {
                    spacing: 1 * Theme.rem;
                    TileView { tile: data.tiles[2]; horizontal-stretch: 1; }
                    TileView { tile: data.tiles[3]; horizontal-stretch: 1; }
                }
            }
            // The chart, or a note that there's nothing logged yet.
            if data.loaded && !data.has-log: HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: 1.4 * Theme.rem;
                        padding-right: 1.4 * Theme.rem;
                        padding-top: 2 * Theme.rem;
                        padding-bottom: 2 * Theme.rem;
                        spacing: 1.2 * Theme.rem;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "chart";
                                size: 2.4 * Theme.rem;
                                tint: Theme.faint;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: T.tr("stats.empty");
                            color: Theme.muted;
                            font-size: 1.2 * Theme.rem;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if data.loaded && data.has-log: HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                chart := Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    VerticalLayout {
                        padding-left: 1.4 * Theme.rem;
                        padding-right: 1.4 * Theme.rem;
                        padding-top: 1.2 * Theme.rem;
                        padding-bottom: 0.8 * Theme.rem;
                        spacing: 1 * Theme.rem;
                        // .chart-head: the readout and the legend.
                        HorizontalLayout {
                            spacing: 1.5 * Theme.rem;
                            Text {
                                horizontal-stretch: 1;
                                text: hover-bar >= 0 && hover-bar < nb ? data.buckets[hover-bar].summary
                                    : StatsPage.readout >= 0 && StatsPage.readout < nb ? data.buckets[StatsPage.readout].summary
                                    : T.tr("stats.hoverHint");
                                color: Theme.text;
                                font-size: 1.1 * Theme.rem;
                                font-weight: 600;
                                min-height: 1.5 * 1.1 * Theme.rem;
                                overflow: elide;
                                vertical-alignment: bottom;
                            }
                            HorizontalLayout {
                                horizontal-stretch: 0;
                                spacing: 1.2 * Theme.rem;
                                for k in [{ c: StatColors.game, l: T.tr("stats.playing") }, { c: StatColors.watch, l: T.tr("stats.watching") }]: HorizontalLayout {
                                    horizontal-stretch: 0;
                                    spacing: 0.45 * Theme.rem;
                                    Rectangle {
                                        width: 0.8 * Theme.rem;
                                        height: 0.8 * Theme.rem;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 0.2 * Theme.rem;
                                        background: k.c;
                                    }
                                    Text {
                                        text: k.l;
                                        color: Theme.muted;
                                        font-size: 1 * Theme.rem;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        // .chart-plot: gridlines with hour labels on the left, a column per bucket.
                        Rectangle {
                            height: 15 * Theme.rem + 2 * Theme.rem;
                            plot := Rectangle {
                                x: 4.2 * Theme.rem;
                                y: 0;
                                width: parent.width - 4.2 * Theme.rem;
                                height: 15 * Theme.rem;
                                for g in data.grid: Rectangle {
                                    x: 0;
                                    y: plot.height * (1 - g.frac);
                                    width: plot.width;
                                    height: 1px;
                                    background: #ffffff14;
                                    Text {
                                        x: -0.7 * Theme.rem - self.width;
                                        y: -0.65 * 0.85 * Theme.rem;
                                        text: g.label;
                                        color: Theme.faint;
                                        font-size: 0.85 * Theme.rem;
                                    }
                                }
                                for b[i] in data.buckets: Rectangle {
                                    private property <length> col-w: (plot.width - (nb - 1) * 2px) / max(1, nb);
                                    private property <bool> focused: scope.has-focus && pos.zone == 1 && pos.bar == i;
                                    private property <length> stack-w: min(col-w * 0.64, 2.6 * Theme.rem);
                                    private property <length> game-h: b.has-game ? max(3px, plot.height * b.game) : 0;
                                    private property <length> watch-h: b.has-watch ? max(3px, plot.height * b.watch) : 0;
                                    x: i * (col-w + 2px);
                                    y: 0;
                                    width: col-w;
                                    height: plot.height;
                                    border-radius: 0.3 * Theme.rem;
                                    background: focused || ta.has-hover ? #ffffff12 : transparent;
                                    border-width: focused ? 2px : 0;
                                    border-color: Theme.focus;
                                    animate background { duration: Motion.fast; }
                                    // The game segment sits on the baseline; watching stacks on top, 2px apart.
                                    if b.has-game: Rectangle {
                                        x: (parent.width - stack-w) / 2;
                                        y: parent.height - game-h;
                                        width: stack-w;
                                        height: game-h;
                                        background: StatColors.game;
                                        border-top-left-radius: b.has-watch ? 0 : 4px;
                                        border-top-right-radius: b.has-watch ? 0 : 4px;
                                    }
                                    if b.has-watch: Rectangle {
                                        x: (parent.width - stack-w) / 2;
                                        y: parent.height - game-h - (b.has-game ? 2px : 0) - watch-h;
                                        width: stack-w;
                                        height: watch-h;
                                        background: StatColors.watch;
                                        border-top-left-radius: 4px;
                                        border-top-right-radius: 4px;
                                    }
                                    if b.label != "": Text {
                                        x: (parent.width - self.width) / 2;
                                        y: parent.height + 0.5 * Theme.rem;
                                        text: b.label;
                                        color: Theme.muted;
                                        font-size: 0.85 * Theme.rem;
                                    }
                                    ta := Pointer {
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                hover-bar = i;
                                            } else if (hover-bar == i) {
                                                hover-bar = -1;
                                                if (pos.zone != 1) { StatsPage.readout = -1; }
                                            }
                                        }
                                        clicked => { set-bar(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // .stat-lists: side by side, stacked on narrow windows.
            if data.loaded: lists := Rectangle {
                private property <length> gap: 2 * Theme.rem;
                private property <length> col-w: narrow ? self.width - 2 * Theme.gutter : (self.width - 2 * Theme.gutter - gap) / 2;
                height: 2 * Theme.rem + (narrow ? played.preferred-height + gap + watched.preferred-height : max(played.preferred-height, watched.preferred-height));
                played := StatListView {
                    x: Theme.gutter;
                    y: 2 * Theme.rem;
                    width: col-w;
                    height: self.preferred-height;
                    title: T.tr("stats.mostPlayed");
                    rows: data.games;
                    series: StatColors.game;
                    focused-row: scope.has-focus && pos.zone == 2 && pos.list == 0 ? pos.row : -1;
                    clicked(i) => { set-row(0, i); StatsPage.open(0, i); }
                    hovered(i) => { if (Input.mode == "mouse") { set-row(0, i); } }
                    options(i) => { set-row(0, i); StatsPage.options(0, i); }
                    reveal(y, h) => { root.reveal(lists.y + self.y + y, h); }
                }
                watched := StatListView {
                    x: narrow ? Theme.gutter : Theme.gutter + col-w + gap;
                    y: narrow ? 2 * Theme.rem + played.preferred-height + gap : 2 * Theme.rem;
                    width: col-w;
                    height: self.preferred-height;
                    title: T.tr("stats.mostWatched");
                    rows: data.watched;
                    series: StatColors.watch;
                    focused-row: scope.has-focus && pos.zone == 2 && pos.list == 1 ? pos.row : -1;
                    clicked(i) => { set-row(1, i); StatsPage.open(1, i); }
                    hovered(i) => { if (Input.mode == "mouse") { set-row(1, i); } }
                    options(i) => { set-row(1, i); StatsPage.options(1, i); }
                    reveal(y, h) => { root.reveal(lists.y + self.y + y, h); }
                }
            }
            if data.loaded: HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-top: 2 * Theme.rem;
                alignment: start;
                Text {
                    width: min(60 * Theme.rem, root.width - 2 * Theme.gutter);
                    text: T.tr("stats.note");
                    color: Theme.faint;
                    font-size: 0.95 * Theme.rem;
                    wrap: word-wrap;
                }
            }
        }
    }
}
