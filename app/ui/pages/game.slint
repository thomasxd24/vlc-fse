// STUB — to be replaced by the real screen. Keep the exported names (GameDetail, GameDetailView): app.slint and Rust use them.
import { Theme } from "../theme.slint";
import { Nav } from "../globals.slint";
import { PageScope } from "../widgets.slint";

export global GameDetail {
    in-out property <int> focus;
}

export component GameDetailView inherits Rectangle {
    PageScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { Nav.focus-top(); return accept; }
            reject
        }
    }
    Text { text: "GameDetailView"; color: Theme.muted; font-size: 2 * Theme.rem; }
}
