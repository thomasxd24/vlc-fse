// Search: the renderer's VIEWS.search + renderResults. A fixed side column (title, the query box and an
// on-screen keyboard) and, to its right, the results grouped by kind (Games, TV Shows, Movies, Apps).
//
// Typing comes from three places: the on-screen keys (A / click), a physical keyboard (letters, digits
// and space while on this page; Backspace deletes while there's something to delete) — both go to Rust,
// which owns the query and the matching (app/src/ui/pages/search.rs).
//
// Focus has three zones, like the renderer's spatial navigation between the input, the keyboard group
// and the result grids: 0 = the query box, 1 = the keyboard (36 keys, then Space, Delete, Clear),
// 2 = the results (one flat index across every section).

import { Theme, Motion } from "../theme.slint";
import { T, Art, Input, Nav, Hints, Backdrop } from "../globals.slint";
import { Card } from "../types.slint";
import { CardTile, PageScope, Pointer } from "../widgets.slint";

export struct SearchSection {
    title: string,
    apps: bool,        // app tiles (square icon art) instead of posters
    start: int,        // flat index of the first card
    cards: [Card],
}

export global SearchPage {
    in property <string> query;
    in property <[SearchSection]> sections;
    in property <int> total;            // matches before the per-section caps
    in-out property <int> zone: 1;      // 0 = query box, 1 = keyboard, 2 = results
    in-out property <int> key;          // focused key (0 = "a", the renderer's autofocus)
    in-out property <int> card;         // focused result (flat index)
    callback press(string);             // an on-screen key: a letter / digit, " ", "back", "clear"
    callback typed(string) -> bool;     // a physical key's text; true if it was typed into the query
    callback open(int);
    callback options(int);
}

// `.app-tile`: a square tile with the app's icon (or initial) over a gradient of its name's hue.
component AppTile inherits VerticalLayout {
    in property <Card> card;
    in property <bool> focused;
    in property <length> tile-width;
    callback clicked();
    callback hovered();
    callback options();
    width: tile-width;
    spacing: 0.7 * Theme.rem;
    alignment: start;
    Rectangle {
        height: root.tile-width;
        border-radius: Theme.radius;
        background: @radial-gradient(circle, card.tint 0%, card.tint.darker(0.6) 100%);
        transform-scale: focused ? Motion.card-zoom : 1.0;
        animate transform-scale { duration: Motion.normal; easing: Motion.ease; }
        drop-shadow-blur: focused ? 3 * Theme.rem : 1.6 * Theme.rem;
        drop-shadow-offset-y: focused ? 1.2 * Theme.rem : 0.6 * Theme.rem;
        drop-shadow-color: focused ? #000000b3 : #00000073;
        if card.art != "": Image {
            width: parent.width * 0.46;
            height: parent.height * 0.46;
            source: Art.get(card.art, self.width);
            image-fit: contain;
        }
        if card.art == "": Text {
            text: card.subtitle;   // the initial
            color: #ffffffd9;
            font-size: 3 * Theme.rem;
            font-weight: 700;
        }
        Rectangle {
            x: -0.22 * Theme.rem;
            y: -0.22 * Theme.rem;
            width: parent.width + 0.44 * Theme.rem;
            height: parent.height + 0.44 * Theme.rem;
            border-radius: Theme.radius + 0.22 * Theme.rem;
            border-width: 0.22 * Theme.rem;
            border-color: Theme.focus;
            opacity: focused ? 1 : 0;
            animate opacity { duration: Motion.fast; }
        }
        Pointer {
            hovered => { root.hovered(); }
            options => { root.options(); }
            clicked => {
                if (!self.consume-long-press()) {
                    root.clicked();
                }
            }
        }
    }
    Text {
        text: card.title;
        color: Theme.text;
        opacity: focused ? 1 : 0.85;
        font-size: 1.05 * Theme.rem;
        font-weight: 600;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// `.keyboard`: six columns of letters and digits, then Space + Delete and a full-width Clear.
component SearchKeyboard inherits Rectangle {
    in property <length> kb-width;
    in property <int> focused-key;      // -1 = none
    callback pressed(int, string);
    callback hovered(int);
    in property <[string]> keys;
    private property <length> gap: 0.45 * Theme.rem;
    private property <length> key-w: (kb-width - 5 * gap) / 6;
    private property <length> key-h: key-w / 1.25;
    private property <length> wide-h: 0.7 * Theme.rem * 2 + 1.05 * Theme.rem * 1.35;
    width: kb-width;
    height: 6 * (key-h + gap) + 2 * (wide-h + gap) - gap;
    for k[i] in keys: Rectangle {
        private property <bool> focused: i == root.focused-key;
        x: i < 36 ? mod(i, 6) * (key-w + gap) : i == 37 ? 3 * (key-w + gap) : 0;
        y: i < 36 ? floor(i / 6) * (key-h + gap) : 6 * (key-h + gap) + (i == 38 ? wide-h + gap : 0);
        width: i < 36 ? key-w : i == 38 ? root.kb-width : 3 * key-w + 2 * gap;
        height: i < 36 ? key-h : wide-h;
        border-radius: 0.45 * Theme.rem;
        background: focused ? Theme.focus : Theme.surface;
        transform-scale: focused ? 1.1 : 1.0;
        animate transform-scale, background { duration: Motion.fast; easing: Motion.ease; }
        Text {
            text: k == " " ? T.tr("kb.space") : k == "back" ? T.tr("kb.delete") : k == "clear" ? T.tr("kb.clear") : k.to-uppercase();
            color: focused ? Theme.accent-ink : Theme.text;
            font-size: (i < 36 ? 1.35 : 1.05) * Theme.rem;
            font-weight: 600;
        }
        Pointer {
            hovered => { root.hovered(i); }
            clicked => { root.pressed(i, k); }
        }
    }
}

export component SearchView inherits Rectangle {
    private property <[SearchSection]> sections: SearchPage.sections;
    private property <int> zone: SearchPage.zone;
    private property <[string]> kb-keys: ["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z","1","2","3","4","5","6","7","8","9","0"," ","back","clear"];
    private property <bool> active: scope.has-focus;

    // `.search { grid-template-columns: 30rem 1fr; gap: 3rem }` (24rem on smaller windows).
    private property <length> side-w: (Theme.vw <= 1400px ? 24 : 30) * Theme.rem;
    private property <length> results-x: Theme.gutter + side-w + 3 * Theme.rem;
    // Result grids: posters `minmax(11.5rem, 1fr)`, apps `minmax(9.5rem, 1fr)`; gaps 2rem × 1.5rem;
    // the grid keeps the page's right gutter.
    private property <length> gap-x: 1.5 * Theme.rem;
    private property <length> gap-y: 2 * Theme.rem;
    private property <length> inner: self.width - results-x - Theme.gutter;
    private property <int> cols-p: max(1, floor((inner + gap-x) / (11.5 * Theme.rem + gap-x)));
    private property <int> cols-a: max(1, floor((inner + gap-x) / (9.5 * Theme.rem + gap-x)));
    private property <length> tile-p: (inner - (cols-p - 1) * gap-x) / cols-p;
    private property <length> tile-a: (inner - (cols-a - 1) * gap-x) / cols-a;

    // ---- focus helpers (at most four sections)
    function sec-of(i: int) -> int {
        sections.length > 3 && i >= sections[3].start ? 3 : sections.length > 2 && i >= sections[2].start ? 2 : sections.length > 1 && i >= sections[1].start ? 1 : 0
    }
    function cols-of(s: int) -> int { sections[s].apps ? cols-a : cols-p }
    function is-app(i: int) -> bool { sections[sec-of(i)].apps }

    function set-zone(z: int) {
        SearchPage.zone = z;
        Input.feedback("move");
    }
    function set-key(k: int) {
        SearchPage.key = k;
        SearchPage.zone = 1;
        Input.feedback("move");
    }
    function set-card(i: int) {
        SearchPage.card = i;
        SearchPage.zone = 2;
        Input.feedback("move");
    }
    function to-results() {
        if (SearchPage.total > 0) {
            set-card(max(0, min(SearchPage.card, sections[sections.length - 1].start + sections[sections.length - 1].cards.length - 1)));
        }
    }
    function press-key(k: int) {
        Input.feedback("select");
        SearchPage.press(kb-keys[k]);
    }

    function key-nav(e: KeyEvent) -> EventResult {
        let k = SearchPage.key;
        if (e.text == Key.LeftArrow) {
            if ((k < 36 && mod(k, 6) > 0) || k == 37) { set-key(k - 1); }
            return accept;
        }
        if (e.text == Key.RightArrow) {
            if ((k < 36 && mod(k, 6) < 5) || k == 36) { set-key(k + 1); } else { to-results(); }
            return accept;
        }
        if (e.text == Key.UpArrow) {
            if (k < 6) { set-zone(0); }
            else if (k < 36) { set-key(k - 6); }
            else if (k == 36) { set-key(31); }
            else if (k == 37) { set-key(34); }
            else { set-key(36); }
            return accept;
        }
        if (e.text == Key.DownArrow) {
            if (k < 30) { set-key(k + 6); }
            else if (k < 36) { set-key(mod(k, 6) < 3 ? 36 : 37); }
            else if (k < 38) { set-key(38); }
            return accept;
        }
        if (e.text == Key.Return) { press-key(k); return accept; }
        reject
    }

    function card-nav(e: KeyEvent) -> EventResult {
        let i = SearchPage.card;
        let s = sec-of(i);
        let start = sections[s].start;
        let len = sections[s].cards.length;
        let c = cols-of(s);
        let local = i - start;
        let col = mod(local, c);
        if (e.text == Key.LeftArrow) {
            if (col > 0) { set-card(i - 1); } else { set-zone(1); }
            return accept;
        }
        if (e.text == Key.RightArrow) {
            if (col < c - 1 && local < len - 1) { set-card(i + 1); }
            return accept;
        }
        if (e.text == Key.DownArrow) {
            if (local + c < len) { set-card(i + c); }
            else if (floor(local / c) < floor((len - 1) / c)) { set-card(start + len - 1); }
            else if (s + 1 < sections.length) { set-card(sections[s + 1].start + min(col, min(cols-of(s + 1), sections[s + 1].cards.length) - 1)); }
            return accept;
        }
        if (e.text == Key.UpArrow) {
            if (local >= c) { set-card(i - c); }
            else if (s > 0) {
                let pc = cols-of(s - 1);
                let plen = sections[s - 1].cards.length;
                set-card(sections[s - 1].start + min(floor((plen - 1) / pc) * pc + min(col, pc - 1), plen - 1));
            } else { Nav.focus-top(); Input.feedback("move"); }
            return accept;
        }
        if (e.text == Key.PageDown) {
            let t = min(len - 1, local + c * 3);
            if (t != local) { set-card(start + t); }
            return accept;
        }
        if (e.text == Key.PageUp) {
            let t = max(0, local - c * 3);
            if (t != local) { set-card(start + t); }
            return accept;
        }
        if (e.text == Key.Return) { Input.feedback("select"); SearchPage.open(i); return accept; }
        if (e.text == Key.Menu) { SearchPage.options(i); return accept; }
        reject
    }

    // Hints follow what's focused (`data-hint="apps.open"` on app tiles; X only on a result).
    private property <string> hint-ctx: zone == 2 ? (is-app(SearchPage.card) ? "app" : "card") : "keys";
    function update-hints() {
        if (hint-ctx == "keys") {
            Hints.items = [{ button: "a", label: T.tr("hint.select") }, { button: "b", label: T.tr("hint.back") }, { button: "menu", label: T.tr("hint.menu") }];
        } else {
            Hints.items = [{ button: "a", label: hint-ctx == "app" ? T.tr("apps.open") : T.tr("hint.select") }, { button: "b", label: T.tr("hint.back") }, { button: "x", label: T.tr("hint.options") }, { button: "menu", label: T.tr("hint.menu") }];
        }
    }
    changed hint-ctx => { update-hints(); }

    // Results lost (the query changed while a result had focus): back to the keyboard.
    private property <int> total: SearchPage.total;
    changed total => {
        if (total == 0 && SearchPage.zone == 2) { SearchPage.zone = 1; }
    }
    private property <string> query: SearchPage.query;
    changed query => { flick.content-y = 0; }

    init => {
        Backdrop.src = "";
        update-hints();
    }

    // Scroll the results so the focused card is visible, keeping room under the top bar.
    function reveal(top: length, h: length) {
        if (top + flick.content-y < 8 * Theme.rem) {
            flick.content-y = min(0, -(top - 8 * Theme.rem));
        }
        if (top + h + flick.content-y > flick.height - 3 * Theme.rem) {
            flick.content-y = -(top + h - flick.height + 3 * Theme.rem);
        }
    }

    scope := PageScope {
        key-pressed(e) => {
            // A physical keyboard types into the query from anywhere on the page (the renderer's
            // capture handler): letters, digits and space; Backspace deletes while there's text.
            if (!Input.synthetic && !e.modifiers.control && !e.modifiers.alt && SearchPage.typed(e.text)) {
                return accept;
            }
            if (e.text == Key.Backspace && SearchPage.query != "") {
                SearchPage.press("back");
                return accept;
            }
            if (zone == 0) {
                if (e.text == Key.UpArrow) { Nav.focus-top(); Input.feedback("move"); return accept; }
                if (e.text == Key.DownArrow) { set-zone(1); return accept; }
                if (e.text == Key.RightArrow) { to-results(); return accept; }
                if (e.text == Key.LeftArrow || e.text == Key.Return) { return accept; }
                return reject;
            }
            if (zone == 1) { return key-nav(e); }
            card-nav(e)
        }
    }

    // ---- results (scroll under the fixed side column)
    flick := Flickable {
        changed content-y => { Nav.scrolled = self.content-y < -1px; }
        // Starts 1.5rem left of the column so focused cards can zoom without being clipped.
        x: results-x - 1.5 * Theme.rem;
        width: root.width - results-x + 1.5 * Theme.rem;
        content-width: self.width;
        content-height: body.preferred-height;
        animate content-y { duration: Motion.normal; easing: Motion.ease; }
        body := VerticalLayout {
            padding-top: Theme.page-top;
            padding-bottom: 4 * Theme.rem;
            padding-right: Theme.gutter;
            padding-left: 1.5 * Theme.rem;
            alignment: start;
            if SearchPage.query == "": Text {
                text: T.tr("search.hint");
                color: Theme.muted;
                font-size: 1.3 * Theme.rem;
                wrap: word-wrap;
                // .empty-hint with padding-top: 9rem, under the side's page head.
                height: self.preferred-height + 9 * Theme.rem;
                vertical-alignment: bottom;
            }
            if SearchPage.query != "": res := VerticalLayout {
                alignment: start;
                // .page-head > .page-count, aligned with the side's title baseline.
                Text {
                    text: T.trv("search.results", ["n", SearchPage.total]);
                    color: Theme.muted;
                    font-size: 1.2 * Theme.rem;
                    height: 1 * Theme.rem + 3 * Theme.rem * 1.1 + 1.2 * Theme.rem;
                    vertical-alignment: bottom;
                }
                Rectangle { height: 1.2 * Theme.rem + 0.5 * Theme.rem - 1.2 * Theme.rem; }
                for sec in sections: sec-lay := VerticalLayout {
                    private property <int> cols: sec.apps ? cols-a : cols-p;
                    private property <length> tile: sec.apps ? tile-a : tile-p;
                    private property <length> tile-h: sec.apps ? tile + 2.1 * Theme.rem : tile * 1.5 + 3.4 * Theme.rem;
                    alignment: start;
                    // .search-results h2
                    Text {
                        text: sec.title;
                        color: Theme.text;
                        font-size: 1.45 * Theme.rem;
                        font-weight: 700;
                        height: 0.4 * Theme.rem + self.preferred-height;
                        vertical-alignment: bottom;
                    }
                    grid := Rectangle {
                        // .grid: padding .4rem 0 3rem (search), row gap 2rem.
                        height: 0.4 * Theme.rem + ceil(sec.cards.length / cols) * (tile-h + gap-y) - gap-y + 3 * Theme.rem;
                        for c[j] in sec.cards: Rectangle {
                            private property <bool> focused: root.active && zone == 2 && SearchPage.card == sec.start + j;
                            x: mod(j, cols) * (tile + gap-x);
                            y: 0.4 * Theme.rem + floor(j / cols) * (tile-h + gap-y);
                            width: tile;
                            height: tile-h;
                            changed focused => {
                                if (self.focused) { root.reveal(res.y + sec-lay.y + grid.y + self.y, self.height); }
                            }
                            if !sec.apps: CardTile {
                                tile-width: tile;
                                card: c;
                                focused: parent.focused;
                                hovered => { if (Input.mode == "mouse") { SearchPage.card = sec.start + j; SearchPage.zone = 2; } }
                                clicked => { SearchPage.card = sec.start + j; SearchPage.zone = 2; SearchPage.open(sec.start + j); }
                                options => { SearchPage.card = sec.start + j; SearchPage.zone = 2; SearchPage.options(sec.start + j); }
                            }
                            if sec.apps: AppTile {
                                tile-width: tile;
                                card: c;
                                focused: parent.focused;
                                hovered => { if (Input.mode == "mouse") { SearchPage.card = sec.start + j; SearchPage.zone = 2; } }
                                clicked => { SearchPage.card = sec.start + j; SearchPage.zone = 2; SearchPage.open(sec.start + j); }
                                options => { SearchPage.card = sec.start + j; SearchPage.zone = 2; SearchPage.options(sec.start + j); }
                            }
                        }
                    }
                }
                if SearchPage.total == 0: Text {
                    text: T.tr("search.none");
                    color: Theme.muted;
                    font-size: 1.3 * Theme.rem;
                    wrap: word-wrap;
                    height: self.preferred-height + 4 * Theme.rem;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- side column: title, query box, keyboard (`.search-side`, sticky)
    VerticalLayout {
        x: Theme.gutter;
        y: Theme.page-top;
        width: side-w;
        height: self.preferred-height;
        alignment: start;
        // .page-head (padding-left: 0)
        Text {
            text: T.tr("tab.search");
            color: Theme.text;
            font-size: 3 * Theme.rem;
            font-weight: 700;
            letter-spacing: -0.02 * 3 * Theme.rem;
            height: 1 * Theme.rem + self.preferred-height + 1.2 * Theme.rem;
            vertical-alignment: center;
        }
        // .search-box
        box := Rectangle {
            private property <bool> focused: root.active && zone == 0;
            border-radius: 0.6 * Theme.rem;
            background: Theme.surface;
            border-width: focused ? 0.18 * Theme.rem : 1px;
            border-color: focused ? Theme.focus : Theme.line;
            HorizontalLayout {
                padding-top: 1 * Theme.rem;
                padding-bottom: 1 * Theme.rem;
                padding-left: 1.3 * Theme.rem;
                padding-right: 1.3 * Theme.rem;
                spacing: 0;
                Text {
                    text: SearchPage.query == "" ? T.tr("search.placeholder") : SearchPage.query;
                    color: SearchPage.query == "" ? Theme.faint : Theme.text;
                    font-size: 1.6 * Theme.rem;
                    font-weight: 600;
                    overflow: elide;
                }
                Rectangle {
                    width: 0.12 * Theme.rem;
                    background: Theme.text;
                    opacity: box.focused && mod(animation-tick() / 1s, 1) < 0.5 ? 1 : 0;
                }
                Rectangle { }
            }
            Pointer {
                clicked => { SearchPage.zone = 0; }
            }
        }
        Rectangle { height: 1.3 * Theme.rem; }
        SearchKeyboard {
            kb-width: side-w;
            keys: kb-keys;
            focused-key: root.active && zone == 1 ? SearchPage.key : -1;
            hovered(i) => { if (Input.mode == "mouse") { SearchPage.key = i; SearchPage.zone = 1; } }
            pressed(i, k) => { SearchPage.key = i; SearchPage.zone = 1; Input.feedback("select"); SearchPage.press(k); }
        }
    }
}
