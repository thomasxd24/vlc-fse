// The update layer (the renderer's #update-layer / renderUpdateLayer): a full-screen panel while
// Lounge downloads and installs an update — the pulsing mark, "Updating to Lounge x.y.z", a progress
// bar, the status line and "Continue in the background" (hidden once installing has started).
// Rust (app/src/ui/overlays/update.rs) decides when it shows and fills it from the `update` event.

import { Theme, Motion } from "../theme.slint";
import { T, Input } from "../globals.slint";
import { Icons } from "../icons.slint";
import { Btn } from "../widgets.slint";

export global UpdateLayer {
    in-out property <bool> open;
    in property <string> title;       // "Updating to Lounge 3.1.0"
    in property <float> progress;     // 0..1
    in property <string> status;      // "Downloading… 42%" / "Installing…" / elevating text
    in property <bool> can-hide;      // "Continue in the background" is offered (not once installing)
    callback hide();
}

component UpdatePanel inherits Rectangle {
    private property <bool> shown;
    init => {
        shown = true;
        fs.focus();
    }
    opacity: shown ? 1 : 0;
    animate opacity { duration: Motion.reduced ? 0ms : 300ms; easing: Motion.ease; }
    background: #030406fa;
    clip: true;

    // radial-gradient(80% 80% at 50% 40%, rgba(20,22,30,.94), rgba(3,4,6,.98))
    Rectangle {
        x: -0.3 * parent.width;
        width: 1.6 * parent.width;
        y: 0.4 * parent.height - self.height / 2;
        height: 1.6 * parent.width;
        background: @radial-gradient(circle, #14161ef0 0%, #0b0c11f4 30%, #03040600 60%);
    }

    // Pointer input stays inside the layer.
    TouchArea { }

    fs := FocusScope {
        key-pressed(e) => {
            if (UpdateLayer.can-hide && (e.text == Key.Return || e.text == " " || e.text == Key.Escape || e.text == Key.Backspace)) {
                Input.feedback(e.text == Key.Return || e.text == " " ? "select" : "back");
                UpdateLayer.hide();
            }
            accept
        }
    }

    VerticalLayout {
        alignment: center;
        padding-left: 2 * Theme.rem;
        padding-right: 2 * Theme.rem;

        // .brand-mark.big: 4rem, pulsing (scale .9 at the half of a 1.6 s cycle).
        HorizontalLayout {
            alignment: center;
            Image {
                width: 4 * Theme.rem;
                height: 4 * Theme.rem;
                source: Icons.logo;
                image-fit: contain;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: Motion.reduced ? 1.0 : 1 - 0.05 * (1 - cos(360deg * mod(animation-tick(), 1600ms) / 1600ms));
            }
        }
        Rectangle { height: 1.2 * Theme.rem; }
        Text {
            text: UpdateLayer.title;
            font-size: 2.6 * Theme.rem;
            font-weight: 700;
            letter-spacing: -0.02 * 2.6 * Theme.rem;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { height: 1.6 * Theme.rem; }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(30 * Theme.rem, Theme.vw * 0.8);
                height: 0.4 * Theme.rem;
                border-radius: 1 * Theme.rem;
                background: #ffffff29;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, UpdateLayer.progress));
                    animate width { duration: Motion.reduced ? 0ms : 400ms; easing: Motion.ease; }
                    background: Theme.accent;
                }
            }
        }
        Rectangle { height: 0.9 * Theme.rem; }
        Text {
            text: UpdateLayer.status;
            font-size: 1.1 * Theme.rem;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { height: 2 * Theme.rem; }
        HorizontalLayout {
            alignment: center;
            height: hide-btn.min-height;
            hide-btn := Btn {
                visible: UpdateLayer.can-hide;
                text: T.tr("upd.background");
                focused: Input.mode == "pad" || Input.mode == "keyboard";
                clicked => { UpdateLayer.hide(); }
            }
        }
    }
}

export component UpdateLayerView inherits Rectangle {
    if UpdateLayer.open: UpdatePanel { }
}
